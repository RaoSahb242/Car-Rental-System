@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard - Car Rental System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f5f5;
        }

        .welcome-section {
            background-color: #e9ecef;
            padding: 35px 0;
        }

        .dashboard-section {
            margin-top: 35px;
            margin-bottom: 35px;
        }

        .summary-box,
        .management-box,
        .table-box {
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 25px;
            height: 100%;
        }

            .summary-box h2 {
                color: #198754;
            }

            .management-box p {
                color: #666;
            }

        .table-box {
            overflow-x: auto;
        }

        .custom-navbar {
            background-color: #198754;
        }

        .btn-primary {
            background-color: #198754;
            border-color: #198754;
        }

            .btn-primary:hover {
                background-color: #146c43;
                border-color: #146c43;
            }

        .btn-outline-primary {
            color: #198754;
            border-color: #198754;
        }

            .btn-outline-primary:hover {
                background-color: #198754;
                border-color: #198754;
                color: white;
            }

        footer {
            background-color: #212529;
            color: white;
            text-align: center;
            padding: 18px;
            margin-top: 40px;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container">

            <a class="navbar-brand" asp-controller="Admin" asp-action="Index">
                Car Rental System
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="#dashboard">Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#cars">Manage Cars</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#customers">Customers</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#bookings">Bookings</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Logout</a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <section class="welcome-section">
        <div class="container">
            <h1>Admin Dashboard</h1>
            <p class="mb-0">
                Welcome, Admin! Manage cars, customers and rental bookings.
            </p>
        </div>
    </section>

    <div class="container">

        <section class="dashboard-section" id="dashboard">

            <h2 class="mb-4">Dashboard Overview</h2>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="summary-box">
                        <h2>25</h2>
                        <p class="mb-0">Total Cars</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-box">
                        <h2>120</h2>
                        <p class="mb-0">Total Customers</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-box">
                        <h2>48</h2>
                        <p class="mb-0">Total Bookings</p>
                    </div>
                </div>

            </div>
        </section>

        <section class="dashboard-section">

            <h2 class="mb-4">Management</h2>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="management-box">
                        <h5>Manage Cars</h5>
                        <p>Add new cars, update vehicle details and rental prices.</p>
                        <a href="#cars" class="btn btn-primary">Manage Cars</a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="management-box">
                        <h5>Manage Customers</h5>
                        <p>View customer information and manage accounts.</p>
                        <a href="#customers" class="btn btn-primary">View Customers</a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="management-box">
                        <h5>Manage Bookings</h5>
                        <p>Review booking requests and approve or reject them.</p>
                        <a href="#bookings" class="btn btn-primary">View Bookings</a>
                    </div>
                </div>

            </div>
        </section>

        <section class="dashboard-section" id="cars">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Manage Cars</h2>
                <button class="btn btn-primary">+ Add New Car</button>
            </div>

            <div class="table-box">
                <table class="table table-hover table-bordered mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Car ID</th>
                            <th>Car Name</th>
                            <th>Model</th>
                            <th>Price Per Day</th>
                            <th>Availability</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>101</td>
                            <td>Toyota Corolla</td>
                            <td>2024</td>
                            <td>Rs. 8,000</td>
                            <td>Available</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary">Edit</button>
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </td>
                        </tr>

                        <tr>
                            <td>102</td>
                            <td>Honda Civic</td>
                            <td>2023</td>
                            <td>Rs. 12,000</td>
                            <td>Available</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary">Edit</button>
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </td>
                        </tr>

                        <tr>
                            <td>103</td>
                            <td>Toyota Fortuner</td>
                            <td>2024</td>
                            <td>Rs. 20,000</td>
                            <td>Rented</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary">Edit</button>
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </section>

        <section class="dashboard-section" id="customers">

            <h2 class="mb-4">Manage Customers</h2>

            <div class="table-box">
                <table class="table table-hover table-bordered mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Customer ID</th>
                            <th>Full Name</th>
                            <th>Email Address</th>
                            <th>Phone Number</th>
                            <th>Account Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>201</td>
                            <td>Ali Ahmed</td>
                            <td>ali@example.com</td>
                            <td>03001234567</td>
                            <td>Customer</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger">Remove</button>
                            </td>
                        </tr>

                        <tr>
                            <td>202</td>
                            <td>Usman Khan</td>
                            <td>usman@example.com</td>
                            <td>03111234567</td>
                            <td>Customer</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger">Remove</button>
                            </td>
                        </tr>

                        <tr>
                            <td>203</td>
                            <td>Ahmed Raza</td>
                            <td>ahmed@example.com</td>
                            <td>03221234567</td>
                            <td>Customer</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger">Remove</button>
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </section>

        <section class="dashboard-section" id="bookings">

            <h2 class="mb-4">Manage Bookings</h2>

            <div class="table-box">
                <table class="table table-hover table-bordered mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Booking ID</th>
                            <th>Customer Name</th>
                            <th>Car Name</th>
                            <th>Pickup Date</th>
                            <th>Return Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>#CR101</td>
                            <td>Ali Ahmed</td>
                            <td>Toyota Corolla</td>
                            <td>10-Nov-2026</td>
                            <td>12-Nov-2026</td>
                            <td>Rs. 16,000</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                            <td>
                                <button class="btn btn-sm btn-success">Approve</button>
                                <button class="btn btn-sm btn-danger">Reject</button>
                            </td>
                        </tr>

                        <tr>
                            <td>#CR102</td>
                            <td>Usman Khan</td>
                            <td>Honda Civic</td>
                            <td>15-Nov-2026</td>
                            <td>17-Nov-2026</td>
                            <td>Rs. 24,000</td>
                            <td><span class="badge bg-success">Approved</span></td>
                            <td>
                                <button class="btn btn-sm btn-success">Approve</button>
                                <button class="btn btn-sm btn-danger">Reject</button>
                            </td>
                        </tr>

                        <tr>
                            <td>#CR103</td>
                            <td>Ahmed Raza</td>
                            <td>Toyota Fortuner</td>
                            <td>20-Nov-2026</td>
                            <td>21-Nov-2026</td>
                            <td>Rs. 20,000</td>
                            <td><span class="badge bg-danger">Rejected</span></td>
                            <td>
                                <button class="btn btn-sm btn-success">Approve</button>
                                <button class="btn btn-sm btn-danger">Reject</button>
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </section>

    </div>

    <footer>
        <p class="mb-0">© 2026 Car Rental System. All Rights Reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>