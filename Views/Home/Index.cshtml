@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Car Rental System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .navbar {
            background-color: #198754;
        }

        .navbar-brand, .nav-link {
            color: white !important;
        }

            .nav-link:hover {
                color: #ffc107 !important;
            }

        .welcome-section {
            background-color: #e9ecef;
            text-align: center;
            padding: 60px 20px;
        }

            .welcome-section h1 {
                margin-bottom: 15px;
            }

        .car-card {
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 15px;
            height: 100%;
        }

            .car-card img {
                width: 100%;
                height: 200px;
                object-fit: cover;
            }

        .why-section {
            background-color: white;
            padding: 40px 0;
        }

        .why-card {
            border: 1px solid #ddd;
            padding: 20px;
            text-align: center;
            height: 100%;
            background-color: #f8f9fa;
        }

        footer {
            background-color: #343a40;
            color: white;
            padding: 30px 0;
        }

            footer a {
                color: white;
                text-decoration: none;
            }

                footer a:hover {
                    color: #ffc107;
                }

        .btn-primary {
            background-color: #198754;
            border-color: #198754;
        }

            .btn-primary:hover {
                background-color: #146c43;
                border-color: #146c43;
            }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Car Rental System
            </a>

            <button class="navbar-toggler bg-light" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#cars">Our Cars</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Register">Sign Up</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <section class="welcome-section">

        <div class="container">

            <h1>Welcome to Car Rental System</h1>

            <p>
                Find and book your favourite car at affordable prices.
                We provide different cars for your travel needs.
            </p>

            <a href="#cars" class="btn btn-primary">
                View Cars
            </a>

        </div>

    </section>

    <section class="container my-5" id="cars">

        <h2 class="text-center mb-4">Our Available Cars</h2>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="car-card">

                    <img src="~/images/car1.jpg" alt="Toyota Corolla">

                    <h4 class="mt-3">Toyota Corolla</h4>
                    <p>Comfortable Sedan</p>
                    <h5>Rs. 8,000 / Day</h5>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                        Book Now
                    </a>

                </div>
            </div>

            <div class="col-md-4">
                <div class="car-card">

                    <img src="~/images/car2.jpg" alt="Honda Civic">

                    <h4 class="mt-3">Honda Civic</h4>
                    <p>Premium Sedan</p>
                    <h5>Rs. 12,000 / Day</h5>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                        Book Now
                    </a>

                </div>
            </div>

            <div class="col-md-4">
                <div class="car-card">

                    <img src="~/images/car3.jpg" alt="Toyota Fortuner">

                    <h4 class="mt-3">Toyota Fortuner</h4>
                    <p>Luxury SUV</p>
                    <h5>Rs. 20,000 / Day</h5>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                        Book Now
                    </a>

                </div>
            </div>

        </div>

    </section>

    <section class="why-section">

        <div class="container">

            <h2 class="text-center mb-4">Why Choose Us?</h2>

            <div class="row g-3">

                <div class="col-md-3">
                    <div class="why-card">
                        <h5>Car Selection</h5>
                        <p>Choose from different available cars.</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="why-card">
                        <h5>Affordable Prices</h5>
                        <p>Get cars at reasonable rental prices.</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="why-card">
                        <h5>Easy Booking</h5>
                        <p>Book your selected car easily.</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="why-card">
                        <h5>Good Service</h5>
                        <p>We care about our customers.</p>
                    </div>
                </div>

            </div>

        </div>

    </section>

    <footer>

        <div class="container">

            <div class="row">

                <div class="col-md-4">
                    <h5>Car Rental System</h5>
                    <p>We provide cars for rent at affordable prices.</p>
                </div>

                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <p><a asp-controller="Home" asp-action="Index">Home</a></p>
                    <p><a href="#cars">Our Cars</a></p>
                    <p><a asp-controller="Account" asp-action="Login">Login</a></p>
                    <p><a asp-controller="Account" asp-action="Register">Sign Up</a></p>
                </div>

                <div class="col-md-4">
                    <h5>Contact Us</h5>
                    <p>Pakistan</p>
                    <p>Email: raowasimraja1@gmail.com</p>
                    <p>Phone: +92 301 2110242</p>
                </div>

            </div>

            <hr>

            <p class="text-center mb-0">
                © 2026 Car Rental System. All Rights Reserved.
            </p>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>