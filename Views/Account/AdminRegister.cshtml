@{
    ViewData["Title"] = "Admin Registration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Registration - Car Rental System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f5f5;
        }

        .signup-box {
            max-width: 450px;
            margin: 50px auto;
            padding: 30px;
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

            .signup-box h2 {
                margin-bottom: 10px;
            }

        .navbar {
            background-color: #198754 !important;
        }

        .btn-primary {
            background-color: #198754;
            border-color: #198754;
        }

            .btn-primary:hover {
                background-color: #146c43;
                border-color: #146c43;
            }
    </style>
</head>

<body>

    <nav class="navbar navbar-dark">
        <div class="container">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Car Rental System
            </a>

            <a asp-controller="Home" asp-action="Index"
               class="text-white text-decoration-none">
                Home
            </a>

        </div>
    </nav>

    <div class="container">

        <div class="signup-box">

            <h2 class="text-center">Admin Registration</h2>

            <p class="text-center text-muted mb-4">
                Create your administrator account
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="AdminRegister" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="FullName" class="form-control"
                           placeholder="Enter your full name" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="Email" class="form-control"
                           placeholder="Enter your email" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <input type="tel" name="PhoneNumber" class="form-control"
                           placeholder="Enter your phone number" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="Password" class="form-control"
                           placeholder="Create password" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input type="password" name="ConfirmPassword" class="form-control"
                           placeholder="Confirm password" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Admin Setup Code</label>
                    <input type="password" name="SetupCode" class="form-control"
                           placeholder="Enter admin setup code" required>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Create Admin Account
                </button>

            </form>

            <p class="text-center mt-4 mb-0">
                Already have an account?
                <a asp-controller="Account" asp-action="Login">Login</a>
            </p>

        </div>

    </div>

</body>
</html>