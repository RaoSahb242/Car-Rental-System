<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Car Rental System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .navbar {
            background-color: #198754;
        }

        .navbar-brand, .nav-link {
            color: white !important;
        }

            .nav-link:hover {
                color: #ffc107 !important;
            }

        footer {
            background-color: #343a40;
            color: white;
            padding: 30px 0;
        }

            footer a {
                color: white;
                text-decoration: none;
            }

                footer a:hover {
                    color: #ffc107;
                }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Car Rental System
            </a>

            <button class="navbar-toggler bg-light" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cars" asp-action="Index">
                            Our Cars
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            Login
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Register">
                            Sign Up
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>

        <div class="container">

            <div class="row">

                <div class="col-md-4">
                    <h5>Car Rental System</h5>
                    <p>We provide cars for rent at affordable prices.</p>
                </div>

                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <p>
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </p>
                    <p>
                        <a asp-controller="Cars" asp-action="Index">Our Cars</a>
                    </p>
                    <p>
                        <a asp-controller="Account" asp-action="Login">Login</a>
                    </p>
                    <p>
                        <a asp-controller="Account" asp-action="Register">Sign Up</a>
                    </p>
                </div>

                <div class="col-md-4">
                    <h5>Contact Us</h5>
                    <p>Pakistan</p>
                    <p>Email: raowasimraja1@gmail.com</p>
                    <p>Phone: +92 301 2110242</p>
                </div>

            </div>

            <hr />

            <p class="text-center mb-0">
                © 2026 Car Rental System. All Rights Reserved.
            </p>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>