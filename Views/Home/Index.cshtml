@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <style>
        .welcome-section {
            background-color: #e9ecef;
            text-align: center;
            padding: 60px 20px;
        }

            .welcome-section h1 {
                margin-bottom: 15px;
            }

        .car-card {
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 15px;
            height: 100%;
        }

            .car-card img {
                width: 100%;
                height: 200px;
                object-fit: cover;
            }

        .why-section {
            background-color: white;
            padding: 40px 0;
        }

        .why-card {
            border: 1px solid #ddd;
            padding: 20px;
            text-align: center;
            height: 100%;
            background-color: #f8f9fa;
        }

        .btn-primary {
            background-color: #198754;
            border-color: #198754;
        }

            .btn-primary:hover {
                background-color: #146c43;
                border-color: #146c43;
            }
    </style>
}

<section class="welcome-section">

    <div class="container">

        <h1>Welcome to Car Rental System</h1>

        <p>
            Find and book your favourite car at affordable prices.
            We provide different cars for your travel needs.
        </p>

        <a href="#cars" class="btn btn-primary">
            View Cars
        </a>

    </div>

</section>

<section class="container my-5" id="cars">

    <h2 class="text-center mb-4">Our Available Cars</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="car-card">

                <img src="~/images/car1.jpg" alt="Toyota Corolla">

                <h4 class="mt-3">Toyota Corolla</h4>
                <p>Comfortable Sedan</p>
                <h5>Rs. 8,000 / Day</h5>

                <a asp-controller="Account" asp-action="Login"
                   class="btn btn-primary w-100">
                    Book Now
                </a>

            </div>
        </div>

        <div class="col-md-4">
            <div class="car-card">

                <img src="~/images/car2.jpg" alt="Honda Civic">

                <h4 class="mt-3">Honda Civic</h4>
                <p>Premium Sedan</p>
                <h5>Rs. 12,000 / Day</h5>

                <a asp-controller="Account" asp-action="Login"
                   class="btn btn-primary w-100">
                    Book Now
                </a>

            </div>
        </div>

        <div class="col-md-4">
            <div class="car-card">

                <img src="~/images/car3.jpg" alt="Toyota Fortuner">

                <h4 class="mt-3">Toyota Fortuner</h4>
                <p>Luxury SUV</p>
                <h5>Rs. 20,000 / Day</h5>

                <a asp-controller="Account" asp-action="Login"
                   class="btn btn-primary w-100">
                    Book Now
                </a>

            </div>
        </div>

    </div>

</section>

<section class="why-section">

    <div class="container">

        <h2 class="text-center mb-4">Why Choose Us?</h2>

        <div class="row g-3">

            <div class="col-md-3">
                <div class="why-card">
                    <h5>Car Selection</h5>
                    <p>Choose from different available cars.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="why-card">
                    <h5>Affordable Prices</h5>
                    <p>Get cars at reasonable rental prices.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="why-card">
                    <h5>Easy Booking</h5>
                    <p>Book your selected car easily.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="why-card">
                    <h5>Good Service</h5>
                    <p>We care about our customers.</p>
                </div>
            </div>

        </div>

    </div>

</section>