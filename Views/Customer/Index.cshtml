@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Customer Dashboard | Car Rental System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f5f5;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background-color: #198754 !important;
        }

        .welcome-section {
            background-color: #e9ecef;
            padding: 40px 0;
        }

        .dashboard-section {
            padding: 35px 0;
        }

        .section-heading {
            margin-bottom: 20px;
        }

        .summary-card,
        .car-card,
        .table-section,
        .profile-card {
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 25px;
            height: 100%;
        }

            .summary-card h3 {
                font-size: 28px;
                font-weight: bold;
                color: #212529;
            }

            .summary-card p {
                color: #6c757d;
                margin-bottom: 0;
            }

        .car-card {
            padding: 0;
            overflow: hidden;
        }

            .car-card img {
                width: 100%;
                height: 200px;
                object-fit: cover;
            }

        .car-details {
            padding: 20px;
        }

        .car-price {
            font-size: 18px;
            font-weight: bold;
            color: #212529;
        }

        .table-section {
            overflow-x: auto;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
            padding: 5px 10px;
            border-radius: 5px;
        }

        .status-approved {
            background-color: #d1e7dd;
            color: #0f5132;
            padding: 5px 10px;
            border-radius: 5px;
        }

        .profile-card p {
            margin-bottom: 12px;
        }

        .custom-footer {
            background-color: #212529;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 20px;
        }

            .custom-footer p {
                margin: 0;
            }

        .btn-primary {
            background-color: #198754;
            border-color: #198754;
        }

            .btn-primary:hover {
                background-color: #146c43;
                border-color: #146c43;
            }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a class="navbar-brand" asp-controller="Customer" asp-action="Index">
                Car Rental System
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#customerNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="customerNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Index">Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#available-cars">Available Cars</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#my-bookings">My Bookings</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#profile">My Profile</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Logout</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <section class="welcome-section">

        <div class="container">

            <h1>Welcome to Your Dashboard!</h1>

            <p>
                Find your preferred car, explore available vehicles
                and manage your bookings from one place.
            </p>

            <a href="#available-cars" class="btn btn-primary mt-2">
                Explore Available Cars
            </a>

        </div>

    </section>

    <section class="dashboard-section">

        <div class="container">

            <h2 class="section-heading">My Dashboard</h2>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="summary-card">
                        <h3>03</h3>
                        <p>Total Bookings</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-card">
                        <h3>01</h3>
                        <p>Pending Bookings</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-card">
                        <h3>02</h3>
                        <p>Approved Bookings</p>
                    </div>
                </div>

            </div>

        </div>

    </section>

    <section class="dashboard-section pt-2" id="available-cars">

        <div class="container">

            <h2 class="section-heading">Available Cars</h2>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="car-card">

                        <img src="~/images/car1.jpg" alt="Toyota Corolla">

                        <div class="car-details">

                            <h5>Toyota Corolla</h5>

                            <p class="text-muted">
                                Comfortable and reliable sedan.
                            </p>

                            <p class="car-price">Rs. 8,000 / Day</p>

                            <a href="#my-bookings" class="btn btn-primary w-100">
                                Book Now
                            </a>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="car-card">

                        <img src="~/images/car2.jpg" alt="Honda Civic">

                        <div class="car-details">

                            <h5>Honda Civic</h5>

                            <p class="text-muted">
                                Modern design with premium comfort.
                            </p>

                            <p class="car-price">Rs. 12,000 / Day</p>

                            <a href="#my-bookings" class="btn btn-primary w-100">
                                Book Now
                            </a>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="car-card">

                        <img src="~/images/car3.jpg" alt="Toyota Fortuner">

                        <div class="car-details">

                            <h5>Toyota Fortuner</h5>

                            <p class="text-muted">
                                Spacious SUV for family travel.
                            </p>

                            <p class="car-price">Rs. 20,000 / Day</p>

                            <a href="#my-bookings" class="btn btn-primary w-100">
                                Book Now
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <section class="dashboard-section pt-2" id="my-bookings">

        <div class="container">

            <h2 class="section-heading">My Bookings & History</h2>

            <div class="table-section">

                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Booking ID</th>
                                <th>Car Name</th>
                                <th>Pickup Date</th>
                                <th>Return Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>#CR101</td>
                                <td>Toyota Corolla</td>
                                <td>10-Nov-2026</td>
                                <td>12-Nov-2026</td>
                                <td>Rs. 16,000</td>
                                <td>
                                    <span class="status-approved">Approved</span>
                                </td>
                            </tr>

                            <tr>
                                <td>#CR102</td>
                                <td>Honda Civic</td>
                                <td>15-Nov-2026</td>
                                <td>17-Nov-2026</td>
                                <td>Rs. 24,000</td>
                                <td>
                                    <span class="status-pending">Pending</span>
                                </td>
                            </tr>

                            <tr>
                                <td>#CR103</td>
                                <td>Toyota Fortuner</td>
                                <td>01-Oct-2026</td>
                                <td>02-Oct-2026</td>
                                <td>Rs. 20,000</td>
                                <td>
                                    <span class="status-approved">Approved</span>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </section>

    <section class="dashboard-section pt-2" id="profile">

        <div class="container">

            <h2 class="section-heading">My Profile</h2>

            <div class="profile-card">

                <p>
                    <strong>Full Name:</strong> Rao Wasim Raja
                </p>

                <p>
                    <strong>Email Address:</strong> raowasimraja1.com
                </p>

                <p>
                    <strong>Phone Number:</strong> +92 3012110242
                </p>

                <p>
                    <strong>Account Type:</strong> Customer
                </p>

                <a href="#" class="btn btn-primary mt-2">
                    Edit Profile
                </a>

            </div>

        </div>

    </section>

    <footer class="custom-footer">

        <p>© 2026 Car Rental System. All Rights Reserved.</p>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
